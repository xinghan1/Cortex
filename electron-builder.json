{
  "appId": "com.synora.code",
  "productName": "Cortex",
  "directories": {
    "output": "installer-output",
    "buildResources": "build"
  },
  "files": [
    "src/**/*",
    "package.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "extraFiles": [
    { "from": "README.md", "to": "使用说明.md" },
    { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" },
    { "from": "docs/PLUGIN_DEVELOPMENT.md", "to": "开发者插件/PLUGIN_DEVELOPMENT.md" },
    { "from": "sdk/plugin-api.d.ts", "to": "开发者插件/sdk/plugin-api.d.ts" },
    { "from": "examples/hello-plugin", "to": "开发者插件/examples/hello-plugin" }
  ],
  "extraMetadata": {
    "synoraInstalled": true
  },
  "asar": { "smartUnpack": false },
  "asarUnpack": ["node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/claude.exe", "node_modules/@volcengine/ark-cli/**"],
  "npmRebuild": false,
  "forceCodeSigning": false,
  "publish": null,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "src/renderer/cortex-app-icon.png",
    "artifactName": "Cortex-Setup-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "selectPerMachineByDefault": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Cortex",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false,
    "packElevateHelper": false,
    "include": "build/installer.nsh"
  }
}
