    "build:installer": "node scripts/build-installer.mjs",
    "smoke": "electron . --smoke-test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "electron": "44.9.0",
