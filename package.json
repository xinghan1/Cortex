{
  "name": "cortex",
  "productName": "Cortex",
  "version": "0.24.17",
  "private": true,
  "description": "Multi-model local coding assistant for Windows",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:sdk": "node scripts/prepare-chatgpt-sdk.mjs",
    "prepare:gemini": "node scripts/prepare-gemini-cli.mjs",
    "prepare:zcode": "node scripts/prepare-zcode-agent.mjs",
    "prepare:accounts": "node scripts/prepare-accounts.mjs",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "build:installer": "node scripts/build-installer.mjs",
    "smoke": "electron . --smoke-test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "electron": "44.9.0",
    "electron-builder": "26.17.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@volcengine/ark-cli": "1.0.42",
    "jose": "^6.1.0",
    "openai": "^7.21.0",
    "proper-lockfile": "^4.1.2",
    "qrcode-generator": "^2.0.4"
  }
}
