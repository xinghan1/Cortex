{
  "name": "synora-code",
  "productName": "Synora code",
  "version": "0.22.0",
  "private": true,
  "description": "Multi-model local coding assistant for Windows",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "prepare:sdk": "node scripts/prepare-chatgpt-sdk.mjs",
    "prepare:gemini": "node scripts/prepare-gemini-cli.mjs",
